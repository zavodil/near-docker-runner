{
  "llm_model": "claude-opus-4-20250514",
  "temperature": 0.7,
  "max_tokens": 2000,
  "default_tools": [
    "search",
    "calculator"
  ],
  "default_input": "I don't know what is the capital of Cyprus. Can we talk about it?",
  "agent_config": {
    "verbose": true,
    "max_iterations": 10,
    "early_stopping_method": "generate"
  },
  "output_format": "json",
  "include_metadata": true,
  "config_loading": {
    "load_input_json": true,
    "allow_config_override": true
  },
  "error_handling": {
    "log_level": "INFO",
    "save_errors_to_output": true
  }
}