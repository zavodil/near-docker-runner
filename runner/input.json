{
  "llm_model": "claude-opus-4-20250514",
  "temperature": 0.7,
  "max_tokens": 2000,
  "default_tools": [
    "search",
    "calculator"
  ],
  "default_input": "Hello, how can you help me?",
  "agent_config": {
    "verbose": true,
    "max_iterations": 10,
    "early_stopping_method": "generate"
  },
  "output_format": "json",
  "include_metadata": true,
  "config_loading": {
    "load_input_json": true,
    "allow_config_override": true
  },
  "error_handling": {
    "log_level": "INFO",
    "save_errors_to_output": true
  },
  "tool_config": {
    "handle_import_errors": true,
    "warn_on_missing_tools": true
  }
}